// key bindings: F1 > workbench.action.openGlobalKeybindingsFile
/*
[
  { "key": "ctrl+k s", "command": "workbench.action.files.saveAs" },
  { "key": "ctrl+shift+s", "command": "workbench.action.files.saveAll" },
  { "key": "ctrl+shift+s", "command": "-workbench.action.files.saveAs" }
]
*/

{
  // user
  "workbench.colorTheme": "Light Modern",
  "workbench.sideBar.location": "right",

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.*",
    "*.js": "${capture}.*",
    "package.json": "package-lock.json, .prettier*, prettier*, .editorconfig, .postcssrc.*",
    "main.ts": "index.html, styles.css",
    "AGENTS.md": "skills-lock.json"
  },

  "telemetry.telemetryLevel": "off",
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "dotnetAcquisitionExtension.enableTelemetry": false,

  "editor.minimap.enabled": false,
  "editor.linkedEditing": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
    "source.fixAll.eslint": "always"
  },
  "editor.largeFileOptimizations": false,
  "editor.accessibilitySupport": "off",

  "debug.toolBarLocation": "docked",
  "debug.hideSlowPreLaunchWarning": true,
  "debug.onTaskErrors": "debugAnyway",

  "diffEditor.ignoreTrimWhitespace": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "gitlens.launchpad.indicator.enabled": false,
  "gitlens.telemetry.enabled": false,

  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.enable": {
    "*": false
  },

  "terminal.integrated.defaultProfile.windows": "Command Prompt",

  "js/ts.updateImportsOnFileMove.enabled": "always",

  "files.associations": {
    "*.xml": "html",
    "*.svg": "html",
    "*.css": "tailwindcss"
  },

  "prettier.trailingComma": "none",
  "prettier.printWidth": 120,

  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },

  // workspace
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,

  "js/ts.tsdk.path": "./node_modules/typescript/lib",

  // for 'PostCSS Language Support' extension
  "emmet.includeLanguages": {
    "postcss": "css"
  }
}
